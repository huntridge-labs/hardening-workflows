{
  "$schema": "https://raw.githubusercontent.com/huntridge-labs/hardening-workflows/main/.github/schemas/container-config.schema.json",
  "containers": [
    {
      "name": "busybox-latest",
      "image": "busybox:latest",
      "scanners": [
        "trivy",
        "grype",
        "syft"
      ],
      "allow_failure": true,
      "fail_on_severity": "medium"
    },
    {
      "name": "alpine-pinned",
      "image": {
        "registry": "docker.io",
        "repository": "library",
        "name": "alpine",
        "tag": "3.263.2",
        "digest": "sha256:865b95f46d98cf867a156fe4a135ad3fe50d2056aa3f25ed31662dff6da4eb62"
      },
      "scanners": [
        "trivy",
        "grype"
      ],
      "allow_failure": true,
      "fail_on_severity": "high"
    },
    {
      "name": "ghcr-runner",
      "image": {
        "registry": "ghcr.io",
        "repository": "actions",
        "name": "actions-runner",
        "tag": "latest"
      },
      "registry_username": "${GITHUB_TRIGGERING_ACTOR}",
      "registry": {
        "auth_secret": "GITHUB_TOKEN"
      },
      "scanners": [
        "trivy"
      ],
      "allow_failure": true,
      "fail_on_severity": "high"
    }
  ]
}
