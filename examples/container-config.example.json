{
  "containers": [
    {
      "name": "nginx-alpine",
      "image": "nginx:alpine",
      "scanners": [
        "trivy",
        "grype",
        "syft"
      ],
      "allow_failure": false,
      "fail_on_severity": "critical"
    },
    {
      "name": "ubuntu-latest",
      "image": "ubuntu:latest",
      "scanners": [
        "trivy",
        "grype"
      ],
      "allow_failure": true,
      "fail_on_severity": "medium"
    },
    {
      "name": "ghcr-runner",
      "image": "ghcr.io/actions/actions-runner:latest",
      "registry_username_secret": "GHCR_USERNAME",
      "registry_password_secret": "GITHUB_TOKEN",
      "scanners": [
        "trivy"
      ],
      "allow_failure": true,
      "fail_on_severity": "high"
    }
  ]
}
