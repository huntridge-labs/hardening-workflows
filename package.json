{
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@j-ulrich/release-it-regex-bumper": "^5.3.0",
    "@release-it/conventional-changelog": "^10.0.4",
    "c8": "^10.1.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "release-it": "^19.2.2"
  },
  "dependencies": {
    "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cz-emoji-conventional": "^1.2.1",
    "dateformat": "^5.0.3",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0"
  },
  "scripts": {
    "prepare": "husky",
    "test": "npm run test:bash && npm run test:js && npm run test:python && npm run test:actions",
    "test:bash": "for f in tests/unit/bash/test-*.sh; do bash \"$f\" || exit 1; done",
    "test:js": "for f in tests/unit/javascript/test-*.js; do node \"$f\" || exit 1; done",
    "test:python": "pytest tests/unit/python/ --no-cov -q",
    "test:actions": "python tests/unit/actions/validate-action-schemas.py",
    "test:coverage": "npm run test:coverage:js && npm run test:coverage:python",
    "test:coverage:bash": "bashcov --root . tests/unit/bash/test-*.sh",
    "test:coverage:js": "c8 --reporter=lcov --reporter=text --report-dir=coverage/js npm run test:js",
    "test:coverage:python": "pytest --cov-report=lcov:coverage/python.lcov --cov-report=term",
    "validate": "python tests/unit/actions/validate-action-schemas.py",
    "commitizen": "commitizen init cz-conventional-changelog --save-dev --save-exact --force",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:ci": "release-it --ci",
    "release:preview": "release-it --dry-run --ci",
    "release:changelog": "release-it --changelog --dry-run"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "version": "2.11.2"
}
